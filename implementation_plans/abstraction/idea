        "prompt_version": "balance_sheet_v1",
        "schema_version": "balance_sheet_v1",
    },
}
```

## Generic runner

```python
async def run_enrichment(name: str, records, runtime_config):
    spec = ENRICHMENTS[name]

    request_model = spec["request_model"]
    response_model = spec["response_model"]

    requests = [request_model.model_validate(r) for r in records]

    chain = build_structured_chain(
        prompt_version=spec["prompt_version"],
        response_model=response_model,
        runtime_config=runtime_config,
    )

    return await chain.abatch(requests)
```

That gives you:

```python
results = await run_enrichment(
    "balance_sheet_financials",
    balance_sheet_records,
    config,
)
```

